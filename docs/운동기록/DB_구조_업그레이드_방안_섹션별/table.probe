### user_exercise_session_history
```sql
select * from user_exercise_session_history
  order by id desc
  limit 10;
```

### user_exercise_set_history
```sql
select * from user_exercise_set_history set_h
  order by user_exercise_session_history_id desc
  limit 10;
select count(*) from user_exercise_set_history;
```
```sql
describe user_exercise_set_history;
```

### user_exercise_set_history with unit
```sql
select set_h.count, set_h.weight, sh.weight_type
  from user_exercise_set_history set_h
  join user_exercise_session_history sh
    on set_h.user_exercise_session_history_id = sh.id
  order by sh.id desc
  limit 10;
```

### machine
```sql
select id, name, type, type_detail, line, body_part, status
  from machine
  -- where name like '%dumb%'
  order by id;
select count(*) from machine;
```

### machine group by type, type_detail
```sql
select type, type_detail, count(*) from machine
  group by type, type_detail
  order by type, type_detail;
select count(*) from (
  select type, type_detail from machine
  group by type, type_detail
  order by type, type_detail
) as machine_group;
```

### user_exercise_session_history with machine
```sql
select sh.id, sh.exercise_id, sh.weight_type,
  m.name as machine_name
  from user_exercise_session_history sh
  join machine m
    on sh.machine_id = m.id
  order by sh.id desc
  limit 10;
```

### USER_EXERCISE_SESSION_HISTORY WITH SET_HISTORY, EXERCISE
```sql
select session_h.id, session_h.weight_type
  , set_h.count, set_h.weight
  , e.name as exercise_name, e.unit, e.has_weight, e.movement_pattern
  from user_exercise_session_history session_h
  join user_exercise_set_history set_h
    on session_h.id = set_h.user_exercise_session_history_id
  join exercise e
    on session_h.exercise_id = e.id
  order by session_h.id desc
  limit 10;
```
