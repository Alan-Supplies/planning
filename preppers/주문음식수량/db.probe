-- 1. 한 주문 안에서 같은 음식(food_id)의 최대 수량
```sql
SELECT cof.customer_order_id, MAX(co.store_id) AS store_id, s.name
  , MAX(co.ordered_at) AS ordered_at,
       cof.food_id, MAX(cof.name) AS name, COUNT(*) AS qty
FROM customer_order_food cof
JOIN customer_order co ON co.id = cof.customer_order_id
JOIN store s ON s.id = co.store_id
WHERE cof.deleted_yn = 'n' AND co.deleted_yn = 'n' AND co.canceled_at IS NULL
GROUP BY cof.customer_order_id, cof.food_id
ORDER BY qty DESC
LIMIT 20;
```

### menu
```sql
SELECT *
  FROM menu
  WHERE name like '%a매장식사%';
```

### select customer_order
```sql
SELECT store_id, s.name, order_number, user_id, order_amount, payment_amount, platform, service_type
  FROM   customer_order
    left join store s on s.id = store_id
  WHERE customer_order.id = 5313535;
```
```sql
SELECT co.store_id, s.name, co.order_number, co.user_id, co.order_amount, co.payment_amount
  , co.platform, co.service_type
  -- , cof.food_id, cof.name
  FROM   customer_order co
  -- LEFT JOIN customer_order_food cof ON cof.customer_order_id = co.id
    left join store s on s.id = co.store_id
  WHERE co.id = 5313535;
```
### customer_order_id 5774453
```sql
SELECT store_id, s.name, order_number, user_id, order_amount, payment_amount, platform, service_type
  FROM   customer_order
    left join store s on s.id = store_id
  WHERE customer_order.id = 5774453;
```

```sql
SELECT s.name, count(*), food_id, cof.`name`, co.created_at
  FROM customer_order_food cof
    left join customer_order co on co.id = cof.customer_order_id
    left join store s on s.id = co.store_id
  WHERE customer_order_id = 5774453
  group by  cof.name
```

### customer_order_food
```sql
SELECT count(*), food_id, `name`
  FROM customer_order_food
  WHERE customer_order_id = 5517066
  group by  `name`
```


